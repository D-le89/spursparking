# Copy this file to .env and fill in real values, or export these as
# real environment variables before running notifier.py.
# If left unset, notifier.py runs in DRY RUN mode (prints instead of sending).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=youraddress@gmail.com
